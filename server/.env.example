PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ecopulse
CLIENT_ORIGIN=http://localhost:5173
AUTH_SECRET=replace_with_a_long_random_secret
SESSION_SECRET=replace_with_a_long_random_secret
WEBAUTHN_RP_NAME=EcoPulse
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173
WATER_ANOMALY_THRESHOLD_PERCENT=30
ELECTRICITY_ANOMALY_THRESHOLD_PERCENT=30
ELECTRICITY_TARIFF_PER_KWH=8
CO2_KG_PER_KWH=0.7
PAPER_SHEETS_PER_CLASS_SESSION=1
GREENERY_TARGET_PERCENT=60
DEMO_MODE=true
PARKING_STALE_MINUTES=30
JWT_EXPIRES_IN=8h
COOKIE_NAME=ecopulse_token
